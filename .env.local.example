# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Must be the full Project URL, not the bare project ref.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Enables the "describe your week" box that turns notes into tasks.
# Server-side only — deliberately NOT NEXT_PUBLIC_, since that would ship your
# key to every browser. Without it the app works; only that box is disabled.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
