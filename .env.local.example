# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# Must be the full Project URL, not the bare project ref.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Enables the "describe your week" box that turns notes into tasks.
# Server-side only — deliberately NOT NEXT_PUBLIC_, since that would ship your
# key to every browser. Without it the app works; only that box is disabled.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Enables Google Calendar sync, which subtracts your meetings from
# your availability. All three are needed together; without them the app works
# and only that panel on /availability is disabled.
#
# The client ID and secret are the SAME pair you gave Supabase's Google provider
# (Google Cloud Console -> APIs & Services -> Credentials). LockIN needs them
# directly because Supabase hands over the Google refresh token but never
# refreshes it for us.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# Supabase -> Project Settings -> API -> service_role. Bypasses Row Level
# Security, so it is used for exactly one table: google_credentials, which is
# locked to this key alone so a stored Google refresh token can never be read
# from the browser. Server-side only — never NEXT_PUBLIC_, never committed.
SUPABASE_SERVICE_ROLE_KEY=...
